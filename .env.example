# Copy to .env and fill in. Never commit .env.

# auto = use Gemini if a key/Vertex is configured, otherwise mock. Force with: mock | gemini
LLM_MODE=auto

# Option A (local development): Google AI Studio API key
GEMINI_API_KEY=

# Option B (Cloud Run / Vertex AI): uses the service account, no key needed
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Model names: using gemini-3.8-flash supported by Google AI Studio
MODEL_FAST=gemini-3.8-flash
MODEL_REASON=gemini-3.8-flash
